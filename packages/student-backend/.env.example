# 学生端后端环境变量配置示例
# 复制本文件为 .env 并修改，或在开发环境下直接使用 .env.development

# 教师端 WebSocket 地址（学生端长连接目标）
NC_CONTROLLER_URL=ws://127.0.0.1:8765/ws

# 教师端外部 HTTP API 地址
NC_CONTROLLER_API_URL=http://127.0.0.1:8770

# 学生端本地 HTTP API 监听地址
NC_LOCAL_API_HOST=127.0.0.1

# 学生端本地 HTTP API 监听端口
NC_LOCAL_API_PORT=8772

# 上游 DNS 服务器
NC_UPSTREAM_DNS=114.114.114.114

# 局域网子网（JSON 数组）
NC_LAN_SUBNETS=["192.168.1.0/24"]

# 是否显示系统托盘图标
NC_TRAY_VISIBLE=true

# 托盘退出密码 SHA-256（默认 admin123）
# NC_TRAY_PASSWORD_HASH=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9

# 锁屏解锁密码 SHA-256（默认 admin123）
# NC_UNLOCK_PASSWORD_HASH=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
